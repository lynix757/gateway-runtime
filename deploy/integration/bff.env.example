# Start infrastructure:
# docker compose -f deploy/integration/docker-compose.yml up -d

BFF_HTTP_ADDR=:18080
BFF_HTTP_PUBLIC_URL=http://localhost:18080
BFF_HTTP_BASE_PATH=
BFF_STORE_BACKEND=redis
BFF_REDIS_URL=redis://localhost:16379/0
BFF_REDIS_PREFIX=rebff-it
BFF_OIDC_ISSUER=http://localhost:18081/realms/rebff
BFF_OIDC_CLIENT_ID=rebff-bff
BFF_OIDC_CLIENT_SECRET=rebff-dev-secret
BFF_OIDC_SCOPES=openid,profile,email
BFF_POLICY_PROVIDER=static
BFF_POLICY_ROLE_PERMISSIONS={"admin":["managed-item.read","storage.upload"],"viewer":["managed-item.read"]}
BFF_POLICY_ROLE_CAPABILITIES={"admin":["asset-admin"]}
