{
  "realm": "rebff",
  "enabled": true,
  "displayName": "rebff integration",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "roles": {
    "realm": [
      {"name": "admin"},
      {"name": "viewer"}
    ]
  },
  "clients": [
    {
      "clientId": "rebff-bff",
      "name": "rebff-bff",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "rebff-dev-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:18080/auth/callback",
        "http://localhost:18082/auth/callback",
        "http://localhost:18083/auth/callback"
      ],
      "webOrigins": [
        "http://localhost:18080",
        "http://localhost:18082",
        "http://localhost:18083"
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:18080/*##http://localhost:18082/*##http://localhost:18083/*"
      },
      "protocolMappers": [
        {
          "name": "realm-roles-flat",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "roles",
            "jsonType.label": "String"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "email": "alice@example.com",
      "firstName": "Alice",
      "lastName": "Admin",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "alice-password",
          "temporary": false
        }
      ],
      "realmRoles": ["admin"]
    },
    {
      "username": "bob",
      "enabled": true,
      "email": "bob@example.com",
      "firstName": "Bob",
      "lastName": "Viewer",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "bob-password",
          "temporary": false
        }
      ],
      "realmRoles": ["viewer"]
    }
  ]
}
