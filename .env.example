# Runtime role/capabilities
GATEWAY_ROLE=rebff
GATEWAY_CAPABILITIES=oidc,session,token-refresh,csrf,user-context,api-proxy,coarse-authz,audit,trace-propagation
# Examples:
# GATEWAY_ROLE=storage
# GATEWAY_CAPABILITIES=upload,download,multipart,presign,metadata,audit
# GATEWAY_ROLE=storage,streaming
# GATEWAY_CAPABILITIES=storage:upload|download;streaming:playback|token

# Storage role provider
STORAGE_SIGNER_BASE_URL=
STORAGE_SIGNER_TIMEOUT=5s
STORAGE_PRESIGN_DEFAULT_TTL=15m
STORAGE_PRESIGN_MAX_TTL=1h

# HTTP
BFF_HTTP_ADDR=:8080
BFF_HTTP_PUBLIC_URL=http://localhost:8080
BFF_HTTP_BASE_PATH=
BFF_TRUSTED_PROXY_CIDRS=

# OIDC
BFF_OIDC_ISSUER=
BFF_OIDC_CLIENT_ID=
BFF_OIDC_CLIENT_SECRET=
BFF_OIDC_SCOPES=openid,profile,email

# Store: memory | redis
BFF_STORE_BACKEND=memory
BFF_REDIS_URL=redis://localhost:6379/0
BFF_REDIS_PREFIX=rebff

# Policy
BFF_POLICY_PROVIDER=static
BFF_POLICY_ROLE_PERMISSIONS={"admin":["asset.read","asset.write"],"viewer":["asset.read"]}
BFF_POLICY_ROLE_CAPABILITIES={"admin":["asset-admin"]}

# Session/token lifecycle
BFF_SESSION_MAX_LIFETIME=8h
BFF_SESSION_IDLE_TIMEOUT=30m
BFF_SESSION_TOUCH_INTERVAL=1m

# Operational limits (per BFF replica)
BFF_LIMIT_MAX_REQUEST_BODY_BYTES=1048576
BFF_LIMIT_MAX_CONCURRENCY=256
BFF_LIMIT_RATE_PER_SECOND=50
BFF_LIMIT_RATE_BURST=100
BFF_LIMIT_RATE_MAX_ENTRIES=10000
BFF_LIMIT_AUTH_RATE_PER_SECOND=0.2
BFF_LIMIT_AUTH_RATE_BURST=10

# Telemetry feature flags
BFF_METRICS_ENABLED=true
BFF_AUDIT_ENABLED=true
BFF_ACCESS_LOG_ENABLED=true
BFF_TRACE_ENABLED=true

# Multi-provider storage registry (preferred for backend API services)
# STORAGE_PROVIDERS_JSON={"minio-main":{"signer_base_url":"http://minio-signer-main:19002"},"minio-archive":{"signer_base_url":"http://minio-signer-archive:19002"}}
# STORAGE_TARGETS_JSON={"asset":{"provider":"minio-main","bucket":"assets"},"archive":{"provider":"minio-archive","bucket":"archive","read_only":true}}

# Workload/service authentication for storage runtime
# STORAGE_WORKLOAD_AUTH_MODE=oidc
# STORAGE_WORKLOAD_AUTH_REQUIRED=true
# STORAGE_WORKLOAD_OIDC_ISSUER=https://sso.example.com/realms/platform
# STORAGE_WORKLOAD_OIDC_AUDIENCE=storage-runtime
