BFF_HTTP_ADDR=:18083
BFF_HTTP_PUBLIC_URL=http://localhost:18083

BFF_STORE_BACKEND=memory

BFF_POLICY_PROVIDER=static
BFF_POLICY_ROLE_PERMISSIONS='{"admin":["asset.read","storage.upload"],"viewer":["asset.read"]}'
BFF_POLICY_ROLE_CAPABILITIES='{"admin":["asset-management"]}'

BFF_METRICS_ENABLED=true
BFF_AUDIT_ENABLED=true
BFF_ACCESS_LOG_ENABLED=true
BFF_TRACE_ENABLED=true

ASSET_API_URL=http://127.0.0.1:19001
STORAGE_API_URL=http://127.0.0.1:19002

# Local Keycloak integration fixture
BFF_OIDC_ISSUER=http://localhost:18081/realms/rebff
BFF_OIDC_CLIENT_ID=rebff-bff
BFF_OIDC_CLIENT_SECRET=rebff-dev-secret
